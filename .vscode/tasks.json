{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cloud: doctor",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "test"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: train NumPy BC",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "train",
        "--epochs",
        "2"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: research page",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "serve"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: setup research environment",
      "type": "process",
      "command": "bash",
      "args": [
        "tools/cloud/bootstrap.sh",
        "--ml",
        "--research"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: offline acceptance",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/phase3.py",
        "acceptance"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: data check",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "data-check"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: replay inspect",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "replay"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: simulate 30 seconds",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "simulate",
        "--seconds",
        "30",
        "--seed",
        "0"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cloud: complete development smoke",
      "type": "process",
      "command": "${workspaceFolder}/.venv-cloud/bin/python",
      "args": [
        "tools/cloud/workspace.py",
        "smoke",
        "--epochs",
        "2"
      ],
      "problemMatcher": []
    }
  ]
}
