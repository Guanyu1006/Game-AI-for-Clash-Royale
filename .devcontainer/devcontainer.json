{
  "name": "Royale Lab — shared CPU research",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "bash tools/cloud/bootstrap.sh --ml --research",
  "forwardPorts": [
    8770
  ],
  "portsAttributes": {
    "8770": {
      "label": "Royale Lab research workbench",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "MS-vsliveshare.vsliveshare",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv-cloud/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "remoteEnv": {
    "PYTHONUTF8": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TMPDIR": "${containerWorkspaceFolder}/.tmp/cloud",
    "PIP_CACHE_DIR": "${containerWorkspaceFolder}/.cache/cloud/pip",
    "TORCH_HOME": "${containerWorkspaceFolder}/.cache/cloud/torch"
  }
}
